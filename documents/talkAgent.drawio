                <mxCell id="state_schema" value="&lt;b&gt;TalkState 状态定义&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;messages: Annotated[list, add_messages]&lt;br&gt;user_text: str&lt;br&gt;has_issue: bool&lt;br&gt;grammar_feedback: str&lt;br&gt;coach_output: str&lt;br&gt;review_decision: str（interrupt 恢复值）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
                    <mxGeometry x="10" y="150" width="200" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="short_memory" value="&lt;b&gt;短期记忆 / 可恢复执行&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;checkpointer = InMemorySaver&lt;br&gt;config 传 thread_id 区分对话线程&lt;br&gt;messages 自动累积上下文&lt;br&gt;interrupt 后从检查点恢复&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
                    <mxGeometry x="10" y="330" width="200" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="node_duty" value="&lt;b&gt;节点职责（与代码对应）&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;transcribe：ASR 工具节点，语音→文本&lt;br&gt;grammar_check：结构化输出 has_issue/issues&lt;br&gt;grammar_tutor：只纠错不改原意，逐条解释&lt;br&gt;polisher：2 个升级版 + 点评&lt;br&gt;coach_reply：回复 + 点评 + 2 个引导提示词&lt;br&gt;review_gate：interrupt() 中断，Command 恢复&lt;br&gt;route_by_grammar：条件边函数（非节点）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
                    <mxGeometry x="10" y="480" width="280" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="fault_tolerance" value="&lt;b&gt;节点容错&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;LLM 节点挂 RetryPolicy&lt;br&gt;（3 次重试，指数退避）&lt;br&gt;timeout = 30s 超时控制&lt;br&gt;失败兜底：返回固定提示文案&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
                    <mxGeometry x="950" y="262" width="200" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="patterns" value="&lt;b&gt;图设计模式&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;Routing：语法条件分支&lt;br&gt;Evaluator：grammar_check 评估&lt;br&gt;Fan-in：双路汇聚 coach_reply&lt;br&gt;Agent Loop：不满意重生成&lt;br&gt;Human-in-the-loop：review_gate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
                    <mxGeometry x="950" y="430" width="200" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="legend" value="图例：实线 = add_edge 静态边  |  虚线 = add_conditional_edges / interrupt 恢复（动态流）&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;浅紫椭圆 = __start__/__end__，浅紫圆角矩形 = 节点；条件边函数不渲染为节点，分支由源节点虚线出边表达（同官网 display() 规范）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=center;" vertex="1" parent="1">
