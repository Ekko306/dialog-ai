                </mxCell>
                <mxCell id="observability" value="&lt;b&gt;可观测性&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;LangSmith trace 每次生成&lt;br&gt;润色采纳率统计&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
                    <mxGeometry x="10" y="400" width="220" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="node_duty" value="&lt;b&gt;节点职责（与代码对应）&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;load_input：读 user_text（语法无误分支才进入）&lt;br&gt;build_prompt：2 个升级版 + 简短点评&lt;br&gt;llm_call：with_structured_output(PolishedText)&lt;br&gt;temperature=0.7 激发创造性&lt;br&gt;fallback：输出 1 个版本 + 通用点评&lt;br&gt;write_state：polished → State + 短期记忆&lt;br&gt;parse_validate：条件边函数（校验 versions ≥ 2，非节点）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
                    <mxGeometry x="10" y="530" width="320" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="params" value="&lt;b&gt;模型与参数调控&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;temperature = 0.7（要发散）&lt;br&gt;max_tokens = 400&lt;br&gt;主模型 + fallbacks=[备用模型]&lt;br&gt;CachePolicy 可选：同句复用&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
                    <mxGeometry x="940" y="160" width="220" height="180" as="geometry"/>
                </mxCell>
