                <mxCell id="settings_note" value="&lt;b&gt;学习设置（运行时上下文）&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;记忆模式（四选一）：&lt;br&gt;对话+闪卡（推荐）/ 闪卡+对话 / 对话 / 闪卡&lt;br&gt;每日学习上限：新词 20 | 复习词 40&lt;br&gt;发音：美音 | 自动发音：开&lt;br&gt;→ config 传入 runtime，不改图结构&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="10" y="140" width="260" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="book_note" value="&lt;b&gt;词书管理&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;分类：热门/大学/高中/初中/小学/生活/其他&lt;br&gt;添加词书 → 词表同步入 Store&lt;br&gt;「我的单词书」= 收藏词单&lt;br&gt;未选词书 → interrupt 引导添加&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="10" y="310" width="260" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="duty_note" value="&lt;b&gt;节点职责（与代码对应）&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;load_settings：读学习设置 config&lt;br&gt;sync_booklist：词表入库 / 校验已选词书&lt;br&gt;plan_today：新词20+复习词40 生成今日队列&lt;br&gt;（SRS 到期优先）&lt;br&gt;session_gate：条件边函数（非节点）&lt;br&gt;按队列头分发，空/达上限 → 报告&lt;br&gt;dialogue_learn：对话场景运用目标词&lt;br&gt;（内部复用 chat_engine 子图）&lt;br&gt;flashcard_review：翻卡 interrupt + SRS&lt;br&gt;daily_report：新词/复习/掌握度报告&lt;br&gt;write_store：写 Store（生词本/画像）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="10" y="460" width="260" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="srs_note" value="&lt;b&gt;闪卡 interrupt + SRS&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;interrupt()：翻面 / 认识 / 不认识&lt;br&gt;Command(resume) 恢复并更新等级&lt;br&gt;不认识 → 降级重回队列&lt;br&gt;认识 → 间隔拉长（1/2/4/7/15 天）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="920" y="140" width="240" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="dialogue_note" value="&lt;b&gt;对话运用目标词&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;角色场景对话强制使用目标词&lt;br&gt;结构化输出检测使用率&lt;br&gt;未使用 → 角色引导再给一次机会&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="920" y="290" width="240" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="fault" value="&lt;b&gt;容错链&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;RetryPolicy(3) + timeout=15s&lt;br&gt;设置缺失 → 默认「对话+闪卡」&lt;br&gt;词库拉取失败 → 本地缓存兜底&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="920" y="420" width="240" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="legend" value="图例：实线 = add_edge 静态边  |  虚线 = add_conditional_edges 动态分支&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;浅紫椭圆 = __start__/__end__，浅紫圆角矩形 = 节点；条件边函数不渲染为节点，分支由源节点虚线出边表达（同官网 display() 规范）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=center;" parent="1" vertex="1">
                    <mxGeometry x="230" y="930" width="700" height="54" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
