                </mxCell>
                <mxCell id="layer_note" value="&lt;b&gt;两层概念（分工）&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;第一层 Tool-Agent：回答「用户选择了&lt;br&gt;什么工具?」—— Registry 中 27+ 个注册项&lt;br&gt;第二层 Tool-Hub：回答「该工具如何&lt;br&gt;执行?」—— 统一会话初始化 + chat_engine&lt;br&gt;+ 结果校验&lt;br&gt;27+ 工具 = 27+ 份配置，不是 27+ 个&lt;br&gt;独立 Agent（否则代码无法维护）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="10" y="140" width="260" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="example_note" value="&lt;b&gt;Registry 配置示例&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;AI词典: {tool_id:&quot;dictionary&quot;,&lt;br&gt;system_prompt:&quot;…&quot;,&lt;br&gt;tools:[dictionary_search, pronunciation],&lt;br&gt;mode:&quot;chat&quot;}&lt;br&gt;句子分析: {tool_id:&quot;sentence_analysis&quot;,&lt;br&gt;tools:[syntax_parser, grammar_analyzer],&lt;br&gt;mode:&quot;analysis&quot;}&lt;br&gt;点击工具 → router 查表载入配置 →&lt;br&gt;chat_engine 自动知道「现在我是谁」&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="10" y="350" width="260" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="duty_note" value="&lt;b&gt;节点职责（与代码对应）&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;parse_tool_args：with_structured_output&lt;br&gt;提取 tool_id + 参数（含图片）&lt;br&gt;registry_lookup：查表配置入 state&lt;br&gt;route_by_tool_type：条件边函数（非节点）&lt;br&gt;三路均复用 chat_engine（页2），仅配置不同&lt;br&gt;result_validate：校验输出 schema / 评分&lt;br&gt;完整性，失败 → 降级模板（≤1次重试）&lt;br&gt;write_state：写练习记录（&quot;已练&quot;计数+1）&lt;br&gt;「我的」分类 = 最近使用历史（thread 恢复）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="10" y="600" width="260" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="mode_note" value="&lt;b&gt;mode 字段 → 执行差异&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;chat：纯对话生成（词典/翻译/文案…）&lt;br&gt;analysis：启用输出 schema + 评分分支&lt;br&gt;（成分分析/批改/语法讲解）&lt;br&gt;game：状态推进提示词 + 多轮 interrupt&lt;br&gt;（猜谜/文字冒险/角色扮演）&lt;br&gt;study：背单词相关（见页4）&lt;br&gt;差异全部来自 registry 配置，图结构不变&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="770" y="480" width="260" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="legend" value="图例：实线 = add_edge 静态边  |  虚线 = add_conditional_edges 动态分支&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;浅紫椭圆 = __start__/__end__，浅紫圆角矩形 = 节点；条件边函数不渲染为节点，分支由源节点虚线出边表达（同官网 display() 规范）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=center;" parent="1" vertex="1">
                    <mxGeometry x="230" y="820" width="700" height="54" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="word-study" name="4-word_study背单词">
        <mxGraphModel dx="602" dy="247" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1169" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="word_study 子图 · 背单词（词书 + 学习设置驱动 · 循环调度）· LangGraph 规范画法&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;实线 = add_edge 静态边，虚线 = add_conditional_edges 动态分支；session_gate 循环调度 = 课程「循环结构」+ Routing 模式&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="200" y="20" width="760" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="start" value="__start__" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ECECFF;strokeColor=#9370DB;fontSize=13;" parent="1" vertex="1">
