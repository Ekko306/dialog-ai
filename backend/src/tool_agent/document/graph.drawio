                <mxCell id="e14" value="resume = regenerate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#333333;fontSize=11;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="review_gate" target="coach_reply" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="445" y="902"/>
                            <mxPoint x="445" y="812"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=11;" parent="1" source="write_state" target="end" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="state_note" value="&lt;b&gt;ChatEngineState 输入 / 输出&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;in: messages（fan-in 累积）&lt;br&gt;in: config_id（role_id 或 tool_id）&lt;br&gt;in: user_text / user_image（拍图）&lt;br&gt;in: learner_profile（Store 画像）&lt;br&gt;out: reply: str（四段：回复/点评/&lt;br&gt;提示词1/提示词2）&lt;br&gt;out: feedback: dict（四维评分）&lt;br&gt;round: 轮次计数&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="10" y="140" width="230" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="registry_note" value="&lt;b&gt;统一注册表（角色=工具同构）&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;role_id（ella/lisa/rachel…）与&lt;br&gt;tool_id（成分分析/词典…）同构：&lt;br&gt;→ system_prompt（人设或任务）&lt;br&gt;→ mode（chat/analysis/game）&lt;br&gt;→ 输出 schema（结构化卡片）&lt;br&gt;→ 可选 function tools（如词典挂&lt;br&gt;dictionary_search / pronunciation）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="10" y="350" width="230" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="welcome_note" value="&lt;b&gt;新会话欢迎语（图九）&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;AI词典 → &quot;你好，请问你要查询什么单词?&quot;&lt;br&gt;句子分析 → &quot;Please provide the English sentence you would like to analyze.&quot;&lt;br&gt;配置载入后 chat_engine 自动知道&quot;现在我是谁&quot;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="10" y="540" width="230" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="duty_note" value="&lt;b&gt;节点职责（与代码对应）&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;transcribe：ASR 工具节点（文本可跳过）&lt;br&gt;resume_or_new：checkpointer.get_state&lt;br&gt;welcome_message：新会话首条引导语&lt;br&gt;session_init：registry 查表载配置&lt;br&gt;（人设/工具词 + mode + schema）&lt;br&gt;build_prompt：系统词 + MessagesPlaceholder&lt;br&gt;llm_call：astream（t=0.6）+fallbacks&lt;br&gt;feedback_analyzer：t=0.2 结构化四维评分&lt;br&gt;（语法/地道/发音/流利度）&lt;br&gt;coach_reply：四段输出+结构化卡片&lt;br&gt;fallback：解析失败降级模板&lt;br&gt;review_gate：interrupt() 等用户回合&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="10" y="680" width="230" height="240" as="geometry"/>
                </mxCell>
                <mxCell id="loop_note" value="&lt;b&gt;多轮循环（Agent Loop）&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;interrupt() 暂停等用户输入&lt;br&gt;Command(resume=消息) 恢复&lt;br&gt;→ build_prompt 携带新消息再走 llm_call&lt;br&gt;重启对话 = 换新 thread_id 从头开始&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="940" y="140" width="220" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="ui_note" value="&lt;b&gt;聊天界面元素 → 图能力映射（图九）&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;麦克风按钮 → transcribe&lt;br&gt;朗读/循环跟读 → TTS（发音设置）&lt;br&gt;语法正确✓ / 地道100 标签 → feedback_analyzer&lt;br&gt;翻译/复制/收藏 → 前端操作 + Store 收藏&lt;br&gt;重启对话 → 新 thread_id&lt;br&gt;结果卡片（句式类型…）→ coach_reply 结构化段&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="940" y="310" width="220" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="params_note" value="&lt;b&gt;模型与参数&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;temperature：0.6 对话 / 0.2 评分&lt;br&gt;streaming = True（逐字渲染）&lt;br&gt;历史窗口截断（近 20 条）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="940" y="520" width="220" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="fault_note2" value="&lt;b&gt;容错链&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;RetryPolicy(3) + timeout=30s&lt;br&gt;四段解析失败 → fallback&lt;br&gt;评分缺失 → 只返回语法项&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="940" y="650" width="220" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="legend" value="图例：实线 = add_edge 静态边  |  虚线 = add_conditional_edges / interrupt 恢复（动态流）&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;浅紫椭圆 = __start__/__end__，浅紫圆角矩形 = 节点；条件边函数不渲染为节点，分支由源节点虚线出边表达（同官网 display() 规范）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=center;" parent="1" vertex="1">
                    <mxGeometry x="230" y="1160" width="700" height="54" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
