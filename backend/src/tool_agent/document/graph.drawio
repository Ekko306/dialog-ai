                <mxCell id="entry_note" value="&lt;b&gt;「我的」首页按键 → 图入口映射&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;· 角色对话卡 Ella/Lisa + 电话按钮 → free_talk（thread_id 恢复历史 / 语音 ASR）&lt;br&gt;· Tab 自由对话 → free_talk&lt;br&gt;· 学习工具宫格：拍图学习（图片模态）/ 单词辅助记忆 / AI小词典 / 翻译助手 / 更多 → tool_hub&lt;br&gt;· 对话中 @工具弹窗 → tool_hub（带上下文调用）&lt;br&gt;· 背单词（词书 + 学习设置）→ word_study&lt;br&gt;· 用户资料 / 金币 / 对话·上课次数 / 我的收藏 / 设置页 → 常规 CRUD API，不入图&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="10" y="140" width="260" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="state_note" value="&lt;b&gt;AppState 状态定义&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;messages: Annotated[list, add_messages]&lt;br&gt;user_text / user_image: str&lt;br&gt;mode: str（free_talk | tool_call | word_study，由用户前端点击传入）&lt;br&gt;role_id / tool_id / book_id: str&lt;br&gt;tool_result / study_report: str&lt;br&gt;learner_profile: dict（Store 画像）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="10" y="410" width="260" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="memory_note" value="&lt;b&gt;持久化与记忆&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;checkpointer：InMemorySaver / PostgresSaver&lt;br&gt;thread_id = 角色/工具+会话ID（历史卡恢复）&lt;br&gt;Store：画像 / 词书 / 生词本 / 学习设置&lt;br&gt;write_state fan-in 汇聚三路&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="10" y="590" width="260" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="route_schema" value="&lt;b&gt;路由依据（用户点击，非 AI 判断）&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;前端按键 → invoke 输入携带：&lt;br&gt;  mode: Literal[&quot;free_talk&quot;,&lt;br&gt;    &quot;tool_call&quot;,&quot;word_study&quot;]&lt;br&gt;  role_id / tool_id / book_id: str | None&lt;br&gt;mode_dispatch 只读 mode 确定性分发&lt;br&gt;（route 函数查字段，非 LLM 调用）&lt;br&gt;tool 细分（选哪个工具）由 tool_hub&lt;br&gt;内部 registry 承担（见页3）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="890" y="140" width="270" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="fault_note" value="&lt;b&gt;容错链&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;RetryPolicy(max_attempts=3)&lt;br&gt;timeout=30s + 指数退避&lt;br&gt;mode 缺失 → 默认 free_talk 兜底&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="890" y="330" width="270" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="obs_note" value="&lt;b&gt;可观测性&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;LangSmith trace 全链路&lt;br&gt;astream 流式 + 首字延迟统计&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="890" y="450" width="270" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="pattern_note" value="&lt;b&gt;图设计模式&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;Routing：总控按用户点击三路分发&lt;br&gt;Orchestrator：子图分工（页2/3/4）&lt;br&gt;子图复用：free_talk 与 27+ 工具共用 chat_engine&lt;br&gt;Human-in-the-loop：各子图 interrupt&lt;br&gt;Agent Loop：多轮对话循环&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="890" y="550" width="270" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="legend" value="图例：实线 = add_edge 静态边  |  虚线 = add_conditional_edges 动态分支&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;浅紫椭圆 = __start__/__end__，浅紫圆角矩形 = 节点；条件边函数不渲染为节点，分支由源节点虚线出边表达（同官网 display() 规范）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=center;" parent="1" vertex="1">
                    <mxGeometry x="230" y="740" width="700" height="54" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
