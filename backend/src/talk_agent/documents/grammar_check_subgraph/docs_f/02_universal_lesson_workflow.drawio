<mxfile host="app.diagrams.net">
    <diagram id="universal-lesson-workflow" name="Universal Lesson Workflow">
        <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="2650" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="Universal Lesson Workflow" style="text;html=1;align=center;fontSize=24;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="520" y="15" width="600" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="LangGraph Graph API · 通用课程执行流程 · 配置驱动模块复用" style="text;html=1;align=center;fontSize=13;fontColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="420" y="55" width="800" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="start" value="START&#10;课时开始" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="730" y="90" width="160" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="load" value="load_lesson_context&#10;输入 lesson_id → 读取课程配置&#10;输出 lesson_config / lesson_type / enabled_modules" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="670" y="185" width="280" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="init" value="init_lesson_state&#10;初始化运行状态 · 模块执行位置&#10;练习进度 / 重试计数 / 完成标志" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="690" y="305" width="240" height="65" as="geometry"/>
