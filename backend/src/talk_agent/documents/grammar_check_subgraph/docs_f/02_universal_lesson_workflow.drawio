                <mxCell id="r_scene" value="启用场景导入？&#10;enabled_modules.scene" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" parent="1" vertex="1">
                    <mxGeometry x="720" y="420" width="180" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="scene_intro" value="scene_intro（可选模块）&#10;显示课程场景 · 解释学习情境" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="690" y="550" width="240" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="r_knowledge" value="启用知识讲解？&#10;enabled_modules.knowledge" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" parent="1" vertex="1">
                    <mxGeometry x="720" y="660" width="180" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="teach_knowledge" value="teach_knowledge（可选模块）&#10;展示预维护知识点 · 更新 current_stage" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="690" y="790" width="240" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="r_exercise" value="启用练习？&#10;enabled_modules.exercise" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" parent="1" vertex="1">
                    <mxGeometry x="720" y="900" width="180" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="exC" value="Exercise Subgraph 练习子图（可复用 · 独立 compile 后挂载）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fillColor=#E1D5E7;strokeColor=#9673A6;arcSize=4;" parent="1" vertex="1">
                    <mxGeometry x="640" y="1030" width="440" height="430" as="geometry"/>
                </mxCell>
                <mxCell id="pq" value="呈现题目 present_question" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="760" y="1070" width="200" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="wa2" value="等待用户文本答案&#10;interrupt() 暂停执行" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="760" y="1160" width="200" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="eva" value="[Agent] Exercise Evaluation Agent&#10;练习答案评价（结构化输出）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" parent="1" vertex="1">
                    <mxGeometry x="750" y="1265" width="220" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="rex" value="条件路由&#10;通过 / 重试 / 兜底" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" parent="1" vertex="1">
                    <mxGeometry x="770" y="1360" width="180" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="r_roleplay" value="启用角色扮演？&#10;enabled_modules.roleplay" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" parent="1" vertex="1">
                    <mxGeometry x="720" y="1510" width="180" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="rpC" value="Roleplay Subgraph 角色扮演子图（可复用 · 多轮 Agent Loop）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fillColor=#E1D5E7;strokeColor=#9673A6;arcSize=4;" parent="1" vertex="1">
                    <mxGeometry x="640" y="1640" width="440" height="430" as="geometry"/>
                </mxCell>
                <mxCell id="enter" value="进入角色 / 建立场景" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="760" y="1680" width="200" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="ra2" value="[Agent] Roleplay Agent&#10;情景对话推进（只演不评）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" parent="1" vertex="1">
                    <mxGeometry x="750" y="1775" width="220" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="wu2" value="等待用户文本回复&#10;interrupt() 暂停执行" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="760" y="1870" width="200" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="rrp" value="判断学习目标&#10;task_completed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" parent="1" vertex="1">
                    <mxGeometry x="770" y="1970" width="180" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="summary" value="lesson_summary&#10;汇总完成状态 / 练习结果 / 角色扮演结果（若启用）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="690" y="2120" width="240" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="save" value="save_progress&#10;保存完成状态 · 练习结果 · 学习记录" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="690" y="2235" width="240" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="endN" value="END&#10;课时完成" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="730" y="2355" width="160" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="gstate" value="Graph State 图状态 · LessonState（所有 Node / Subgraph 读写）&#10;&#10;· lesson_config 课程配置&#10;· current_stage 当前阶段&#10;· current_question 当前练习&#10;· user_answer 用户回答&#10;· evaluation 评价结果&#10;· retry_count 重试计数&#10;· roleplay_history 对话历史&#10;· lesson_completed 完成状态&#10;&#10;身份 / 鉴权 / 模型配置 → Runtime Context" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" parent="1" vertex="1">
                    <mxGeometry x="80" y="1030" width="420" height="300" as="geometry"/>
                </mxCell>
                <mxCell id="ckpt" value="Checkpoint / Persistence 持久化检查点&#10;执行状态快照 · Checkpointer · thread_id&#10;暂停恢复 / 断点续学" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#D5E8D4;strokeColor=#82B366;" parent="1" vertex="1">
                    <mxGeometry x="80" y="1360" width="420" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="rctx" value="Runtime Context 运行上下文（不可变）&#10;user_id / 鉴权 / llm 模型 / rubric 评分标准&#10;经 context_schema 注入 · 不进 Graph State" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fontSize=12;fillColor=#D5E8D4;strokeColor=#82B366;" parent="1" vertex="1">
                    <mxGeometry x="80" y="1555" width="420" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="relC" value="可靠性策略 Reliability（公共机制）" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;fillColor=#F5F5F5;strokeColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="80" y="1730" width="420" height="330" as="geometry"/>
                </mxCell>
                <mxCell id="rb1" value="正常学习循环（非故障）&#10;用户答错 → 评价反馈 → 用户重答&#10;达到最大次数 → 参考答案 + 讲解 → 继续" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="100" y="1780" width="380" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="rb2" value="系统异常处理&#10;LLM / Tool 失败 → Retry → 仍失败 → Fallback&#10;（规则模板兜底 / 降级继续流程）" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="100" y="1895" width="380" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="rb3" value="原则：用户答错 ≠ 系统故障&#10;用户重答环 与 API 重试 分开，不画同一路径" style="text;html=1;align=left;fontSize=12;fontStyle=1;fontColor=#B85450;" parent="1" vertex="1">
                    <mxGeometry x="100" y="2005" width="380" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="future" value="未来扩展（不在当前主流程）&#10;speech_to_text 语音识别 · pronunciation_assessment 发音评价&#10;语音版恢复时替换打字比对环节" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;fontColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="80" y="2100" width="420" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="interC" value="用户交互机制 · 执行服务层（非业务 Agent）" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=13;fillColor=#F5F5F5;strokeColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="1150" y="1030" width="440" height="430" as="geometry"/>
                </mxCell>
                <mxCell id="gw" value="Graph Gateway · 服务层桥梁（非业务 Agent）&#10;接收前端提交的文本输入&#10;转换为 Command(resume=用户输入) 驱动图继续" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=12;fillColor=#FFFFFF;strokeColor=#666666;" parent="1" vertex="1">
