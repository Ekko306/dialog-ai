            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#333333;" value="polisher 子图 · LangGraph 规范画法（与 polisher_subgraph.py 同步）&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;单节点线性结构：实线 = add_edge 静态边；本子图无条件边；讯飞 TTS 在节点内部调用，非独立节点&lt;/font&gt;" vertex="1">
                    <mxGeometry height="40" width="560" x="300" y="20" as="geometry"/>
                </mxCell>
                <mxCell id="3" edge="1" parent="1" source="start" style="edgeStyle=none;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="polisher_node">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="start" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ECECFF;strokeColor=#9370DB;fontSize=13;" value="__start__" vertex="1">
                    <mxGeometry height="40" width="120" x="520" y="190" as="geometry"/>
                </mxCell>
                <mxCell id="2" edge="1" parent="1" source="polisher_node" style="edgeStyle=none;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="end">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="polisher_node" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECECFF;strokeColor=#9370DB;fontSize=13;" value="polisher_node 英语表达润色 + 语音合成&lt;br&gt;输入：raw_text（grammar_check 语法合格分支）&lt;br&gt;流程：读 Skill 规则 → DeepSeek 结构化润色&lt;br&gt;→ 讯飞 TTS 生成美式发音&lt;br&gt;输出：polished_text, explanation, polished_audio, logger" vertex="1">
                    <mxGeometry height="170" width="380" x="390" y="310" as="geometry"/>
                </mxCell>
                <mxCell id="end" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ECECFF;strokeColor=#9370DB;fontSize=13;" value="__end__" vertex="1">
                    <mxGeometry height="40" width="120" x="520" y="580" as="geometry"/>
                </mxCell>
                <mxCell id="schema" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;输入 / 输出 Schema&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;in: raw_text: str&lt;br&gt;（主图 has_issue=False 分支进入）&lt;br&gt;out:&lt;br&gt;- original_text: str（原文原样保留）&lt;br&gt;- polished_text: str（润色后英文）&lt;br&gt;- explanation: str（中文修改说明）&lt;br&gt;- polish_comment: str（兼容旧字段）&lt;br&gt;- polished_audio: bytes（讯飞 TTS MP3）&lt;br&gt;- logger: list[str]（执行日志）&lt;/font&gt;" vertex="1">
                    <mxGeometry height="210" width="230" x="10" y="160" as="geometry"/>
                </mxCell>
                <mxCell id="observability" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;可观测性&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;LangSmith trace 每次润色&lt;br&gt;logger 记录执行路径与 TTS 字节数&lt;br&gt;polished_audio 经 API 返回时为 base64 字符串，前端解码后可播放&lt;/font&gt;" vertex="1">
                    <mxGeometry height="120" width="230" x="10" y="400" as="geometry"/>
                </mxCell>
                <mxCell id="node_duty" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;节点职责（与代码对应）&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;读 raw_text：空输入 → 降级跳过，不调模型&lt;br&gt;load_skill_content：读 english-expression-polisher/SKILL.md&lt;br&gt;polisher_chain：prompt | ChatDeepSeek&lt;br&gt;with_structured_output(PolishResult)&lt;br&gt;PolishResult：original_text / polished_text / explanation&lt;br&gt;模型返回空或异常 → 降级保留原句&lt;br&gt;synthesize_polish_audio：讯飞 TTS → polished_audio 字节&lt;br&gt;TTS 失败或空文本 → 返回 b&quot;&quot;，不中断主流程&lt;/font&gt;" vertex="1">
                    <mxGeometry height="200" width="340" x="10" y="540" as="geometry"/>
                </mxCell>
                <mxCell id="params" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;模型与参数调控&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;ChatDeepSeek · deepseek-chat&lt;br&gt;temperature = 0.2（求稳，不改写原意）&lt;br&gt;timeout = 15s · max_retries = 2&lt;br&gt;Skill 规则注入 system prompt&lt;br&gt;结构化输出 = PolishResult(BaseModel)&lt;/font&gt;" vertex="1">
                    <mxGeometry height="180" width="220" x="940" y="160" as="geometry"/>
                </mxCell>
                <mxCell id="fault" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" value="&lt;b&gt;容错链（三层降级）&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;① 空输入 → 跳过润色，不调模型&lt;br&gt;② 模型返回空 / 调用失败 → 保留原句&lt;br&gt;③ TTS 失败 → polished_audio=b&quot;&quot;&lt;br&gt;保证主图 polisher 下游不断流&lt;/font&gt;" vertex="1">
                    <mxGeometry height="160" width="220" x="940" y="390" as="geometry"/>
                </mxCell>
                <mxCell id="legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=center;" value="图例：实线 = add_edge 静态边（本子图无 add_conditional_edges）&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;浅紫椭圆 = __start__/__end__，浅紫圆角矩形 = 节点；单节点线性结构 START → polisher_node → END；讯飞 TTS 为节点内部辅助函数 synthesize_polish_audio，不渲染为 LangGraph 节点&lt;/font&gt;" vertex="1">
                    <mxGeometry height="54" width="700" x="230" y="690" as="geometry"/>
                </mxCell>
            </root>
