                <mxCell id="schema" value="&lt;b&gt;输入 / 输出 Schema&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;in: user_text: str&lt;br&gt;in: issues: list[str]&lt;br&gt;out: grammar_feedback: str&lt;br&gt;messages 经 add_messages 累积&lt;br&gt;主图 fan-in 到 coach_reply&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
