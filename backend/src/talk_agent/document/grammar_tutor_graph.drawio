                <mxCell id="node_duty" value="&lt;b&gt;节点职责（与代码对应）&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;load_input：读 user_text + issues 列表&lt;br&gt;build_prompt：逐条 错误→正确→原因，鼓励语气&lt;br&gt;llm_call：t=0.2 稳定纠错，max_tokens=512&lt;br&gt;RetryPolicy 挂节点自动重试&lt;br&gt;fallback：按 issues 逐条回显模板文案&lt;br&gt;write_state：grammar_feedback → State + 记忆&lt;br&gt;parse_validate：条件边函数（非空/长度/语种，非节点）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="10" y="530" width="320" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="params" value="&lt;b&gt;模型与参数调控&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;temperature = 0.2（纠错要稳）&lt;br&gt;top_p = 0.9&lt;br&gt;主模型 + fallbacks=[备用模型]&lt;br&gt;提示词常量独立文件便于迭代&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="940" y="160" width="220" height="180" as="geometry"/>
                </mxCell>
