                <mxCell id="schema" value="&lt;b&gt;输入 / 输出 Schema&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;in: messages（add_messages 累积）&lt;br&gt;in: grammar_feedback（fan-in）&lt;br&gt;out: coach_output: str（四段）&lt;br&gt;①回复 ②点评 ③提示词1 ④提示词2&lt;br&gt;AIMessage 写入供下轮短期记忆&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
