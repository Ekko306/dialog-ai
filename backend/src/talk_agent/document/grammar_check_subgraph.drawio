                </mxCell>
                <mxCell id="observability" value="&lt;b&gt;可观测性&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;LangSmith 记录每次调用&lt;br&gt;token 用量与延迟统计&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="10" y="400" width="220" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="node_duty" value="&lt;b&gt;节点职责（与代码对应）&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;load_input：读 user_text + 最近 3 条 messages&lt;br&gt;build_prompt：只判语法系统词 + 2 个 few-shot&lt;br&gt;llm_call：with_structured_output(GrammarVerdict)&lt;br&gt;CachePolicy 命中同句缓存则跳过&lt;br&gt;fallback：备用模型接管，极端固定 has_issue=False&lt;br&gt;write_state：写 has_issue / grammar_feedback&lt;br&gt;parse_validate：条件边函数（pydantic 校验，非节点）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="10" y="530" width="300" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="params" value="&lt;b&gt;模型与参数调控&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;主模型 + fallbacks=[备用模型]&lt;br&gt;temperature = 0（判定要稳定）&lt;br&gt;CachePolicy：同句缓存不重复调用&lt;br&gt;with_structured_output 约束输出&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
                    <mxGeometry x="940" y="160" width="220" height="180" as="geometry"/>
                </mxCell>
