                <mxCell id="schema" value="&lt;b&gt;输入 / 输出 Schema&lt;/b&gt;&lt;hr&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#666666&quot;&gt;in: user_text: str&lt;br&gt;in: messages[-3:]（上下文）&lt;br&gt;out: GrammarVerdict(BaseModel)&lt;br&gt;- has_issue: bool&lt;br&gt;- issues: list[str]&lt;br&gt;写入 TalkState 后返回主图路由&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=6;" parent="1" vertex="1">
