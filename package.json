{
  "name": "dialogai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n frontend,backend -c cyan,magenta \"pnpm dev:frontend\" \"pnpm dev:backend\"",
    "dev:frontend": "cd frontend && pnpm dev",
    "dev:backend": "cd backend && set PYTHONUTF8=1&& uv run langgraph dev",
    
    "dev:frontend:https": "cd frontend && pnpm dev:https",
    "dev:https": "concurrently -n frontend,backend -c cyan,magenta \"pnpm dev:frontend:https\" \"pnpm dev:backend\""
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}